# Copy to .env and adjust as needed: cp .env.example .env

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://dynapredict:dynapredict@localhost:5432/dynapredict
TEST_DATABASE_URL=postgresql://dynapredict:dynapredict@localhost:5433/dynapredict_test

# --- API ---
PORT=3333
NODE_ENV=development
# Origin allowed by CORS (with credentials). Comma-separated for multiple origins.
CORS_ORIGIN=http://localhost:4200

# --- Auth (single fixed user, no User table) ---
# Dev credentials: admin@dynapredict.com / dynapredict123
# Generate a new hash with: node -e "console.log(require('bcrypt').hashSync('<password>', 10))"
AUTH_EMAIL=admin@dynapredict.com
AUTH_PASSWORD_HASH='$2b$10$OdyYOmQp41oMSn1ArDiq8erLkv115W6DHECqimOH6S51brwLSBaCi'
# Use a long random value outside local dev: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# --- Web (read by Vite at build time) ---
VITE_API_URL=http://localhost:3333/api/v1
