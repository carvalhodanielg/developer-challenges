generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MachineType {
  Pump
  Fan
}

// "HF+" is not a valid Prisma identifier; shared-types maps HFPlus <-> "HF+".
enum SensorModel {
  TcAg
  TcAs
  HFPlus
}

model Machine {
  id               String            @id @default(uuid())
  name             String
  type             MachineType
  monitoringPoints MonitoringPoint[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([type])
}

model MonitoringPoint {
  id        String   @id @default(uuid())
  name      String
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  sensor    Sensor?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
}

model Sensor {
  id                String          @id @default(uuid())
  serialNumber      String          @unique
  model             SensorModel
  monitoringPointId String          @unique
  monitoringPoint   MonitoringPoint @relation(fields: [monitoringPointId], references: [id], onDelete: Cascade)
  readings          Reading[]
  createdAt         DateTime        @default(now())

  @@index([model])
}

model Reading {
  id        BigInt   @id @default(autoincrement())
  sensorId  String
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  timestamp DateTime
  value     Float

  @@index([sensorId, timestamp])
}
